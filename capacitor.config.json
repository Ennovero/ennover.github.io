{
  "appId": "com.ielts8.trainer",
  "appName": "IELTS 8 Trainer",
  "webDir": "www",
  "backgroundColor": "#f4f6fb",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#f4f6fb",
    "scrollEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1000,
      "launchAutoHide": true,
      "backgroundColor": "#f4f6fb",
      "showSpinner": false,
      "iosSplashResourceName": "Splash"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#f4f6fb",
      "overlaysWebView": false
    }
  }
}
