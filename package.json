{
  "name": "ielts-band8-trainer",
  "version": "1.0.0",
  "private": true,
  "description": "IELTS Band 8 Trainer — çevrimdışı web uygulaması + iOS (Capacitor) paketi",
  "scripts": {
    "icons": "python tools/make_icons.py",
    "test": "node tests/smoke-test.js",
    "sync:web": "node tools/copy-web.js",
